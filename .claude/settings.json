{
  "permissions": {
    "deny": [
      "Bash(pct destroy *)",
      "Bash(qm destroy *)",
      "Bash(pvesm free *)",
      "Bash(pct restore *)",
      "Bash(qmrestore *)",
      "Bash(pvecm delnode *)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(mkfs*)",
      "Read(./.env)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bloquear-destructivo.sh"
          }
        ]
      }
    ]
  }
}
